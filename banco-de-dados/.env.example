# Exemplos fictícios. Substitua antes de iniciar DEV/PROD; não versione o .env.
POSTGRES_PASSWORD=substitua_por_uma_senha_local_postgres
MONGO_ROOT_PASSWORD=substitua_por_uma_senha_local_mongo

# Portas do host; os bancos continuam em 5432/27017 dentro dos contêineres.
DEV_POSTGRES_PORT=5433
DEV_MONGO_PORT=27018
PROD_POSTGRES_PORT=5434
PROD_MONGO_PORT=27019
